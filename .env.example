# CouchBrawl - Environment Variables Example
# העתק קובץ זה ל-.env ועדכן את הערכים כנדרש

# ========== Server Configuration ==========
# פורט השרת
PORT=3000

# סביבה (development / production)
NODE_ENV=development

# ========== Game Configuration ==========
# זמן ניתוק זמני עבור שחקנים (מילישניות)
ROOM_TIMEOUT=30000

# גודל זירה (pixels)
ARENA_WIDTH=800
ARENA_HEIGHT=600

# מהירות שחקן
PLAYER_SPEED=3

# גודל שחקן (radius)
PLAYER_RADIUS=15

# ========== Socket.io Configuration ==========
# CORS origins (comma separated)
CORS_ORIGINS=*

# Socket.io namespace
SOCKET_NAMESPACE=/

# ========== Security (Production) ==========
# JWT Secret (if implementing authentication)
JWT_SECRET=your-secret-key-here

# Rate limiting (requests per minute)
RATE_LIMIT=60

# ========== Logging ==========
# Log level (debug / info / warn / error)
LOG_LEVEL=info

# ========== Optional: Analytics ==========
# Analytics tracking (true / false)
ENABLE_ANALYTICS=false

# Analytics API key
ANALYTICS_KEY=your-api-key-here
